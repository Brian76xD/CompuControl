# Plantilla de configuración.
# Copia este archivo como ".env" y cambia los valores por los reales.
# El archivo ".env" NO se sube a GitHub; este ".env.example" sí.

# IP de la PC del docente (Master)
MASTER_IP=192.168.1.10

# Puerto TCP en el que escucha el Master
MASTER_PORT=5050

# Código compartido entre el Master y sus esclavos (debe ser igual en todos)
CODIGO_AULA=cambia-este-valor
